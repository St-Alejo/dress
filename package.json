{
  "name": "vestirse-web",
  "private": true,
  "version": "0.1.0",
  "description": "Front Angular del probador de ropa virtual Vestirse (la API vive en el repo dress-back).",
  "workspaces": [
    "packages/shared-types",
    "apps/web"
  ],
  "scripts": {
    "build:packages": "npm run build -w packages/shared-types",
    "dev": "npm start -w apps/web",
    "build": "npm run build:packages && npm run build -w apps/web",
    "test": "npm test --workspaces --if-present",
    "test:invariants": "npm run test:invariants --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": "22.x"
  }
}
