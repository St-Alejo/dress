server {
  listen ${PORT};
  root /usr/share/nginx/html;
  client_max_body_size 12m;

  # Misma política que en desarrollo: el front y la API comparten origen.
  # ^~ impide que la regla de estáticos por extensión (.svg, .png) capture las imágenes de la API.
  location ^~ /api/ {
    # Con variable, nginx re-resuelve el DNS en cada petición: si la API se redespliega
    # y cambia de IP (red privada de Railway), no se queda apuntando a la vieja.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream http://${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
  }

  # Archivos con hash: caché larga. index.html: siempre fresco.
  location ~* \.(?:js|css|woff2?|svg|png|jpg|webp|wasm)$ {
    expires 30d;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}
