# Copia a infra/.env (ignorado por git). docker compose lo lee al interpolar.
AI_WORKER_PORT=8011
WEB_PORT=8090
WORKER_TOKEN=
DEFAULT_PROVIDER=mock
# Token gratuito de Hugging Face (tipo read): motor de prueba virtual en Spaces
HF_TOKEN=
# Groq: control de calidad de la foto y etiquetado de prendas (no genera imagenes)
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
