{
  "name": "@vestirse/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "vision:copy": "node scripts/copy-mediapipe.mjs",
    "prestart": "npm run vision:copy",
    "prebuild": "npm run vision:copy",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:invariants": "node scripts/check-invariants.mjs && ng test --watch=false --include=src/app/features/live-overlay/camera.service.spec.ts"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@mediapipe/tasks-vision": "^0.10.22",
    "@vestirse/shared-types": "0.1.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
