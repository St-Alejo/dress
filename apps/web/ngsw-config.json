{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/i18n/*.json", "/icons/*"]
      }
    },
    {
      "name": "vision-models",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/models/**", "/mediapipe/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalog",
      "urls": ["/api/catalog/**", "/api/media/catalog/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 400,
        "maxAge": "1d",
        "timeout": "4s"
      }
    }
  ]
}
