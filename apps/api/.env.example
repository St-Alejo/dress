PORT=3000
DATABASE_URL=postgresql://vestirse:vestirse@localhost:55432/vestirse
REDIS_HOST=localhost
REDIS_PORT=6380
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=vestirse
S3_SECRET_KEY=vestirse-secret
S3_BUCKET=vestirse
AI_WORKER_URL=http://localhost:8000
# Secreto compartido con el ai-worker (mismo valor en ambos). Vacio = sin autenticacion, solo en local.
WORKER_TOKEN=
# Segundos antes de que el Circuit Breaker abandone Track B y ofrezca el fallback
GENERATION_TIMEOUT_SECONDS=90
# Una generacion sin avance durante este tiempo se marca como fallida (por defecto 2x timeout + 120 s)
# GENERATION_STUCK_SECONDS=300
PHOTO_TTL_HOURS=24
JWT_SECRET=cambia-esto-en-produccion
WEB_ORIGIN=http://localhost:4200

# Cifra la clave de IA guardada desde el panel (minimo 16 caracteres). Generala una vez y no la cambies.
APP_ENCRYPTION_KEY=cambia-esto-por-una-clave-larga-aleatoria
# Respaldo si no hay configuracion de IA en el panel: mock | gemini | fashn | fal-fashn
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
